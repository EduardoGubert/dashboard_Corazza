# ==================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO
# ==================================
# COPIE ESTE ARQUIVO PARA .env E CONFIGURE COM SUAS CREDENCIAIS

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Auth API Configuration
# IMPORTANTE: Use o nome do serviço docker (auth-server) ou o domínio público
REACT_APP_AUTH_API_URL=https://seu-dominio.com/api/auth

# JWT Secret (GERE UM VALOR SEGURO!)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this
